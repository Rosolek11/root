{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
    <div class="mb-3">
        <a href="{{ path('app_post_index') }}" class="btn btn-secondary">Powrót do listy</a>
    </div>

    <div class="card">
        <div class="card-header">
            <h1 class="card-title">{{ post.title }}</h1>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <small class="text-muted">
                    Utworzono: {{ post.createdAt ? post.createdAt|date('d.m.Y H:i') : '-' }}<br>
                    Zaktualizowano: {{ post.updatedAt ? post.updatedAt|date('d.m.Y H:i') : '-' }}
                </small>
            </div>
            <div class="content">
                {{ post.content|nl2br }}
            </div>
        </div>
        <div class="card-footer">
            <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-warning">Edytuj</a>
            <form method="post" action="{{ path('app_post_delete', {'id': post.id}) }}" style="display:inline;" onsubmit="return confirm('Na pewno usunąć ten post?');">
                <button type="submit" class="btn btn-danger">Usuń</button>
            </form>
        </div>
    </div>
{% endblock %}
